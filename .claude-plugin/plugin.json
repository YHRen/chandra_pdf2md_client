{
  "name": "chandra-hybrid-parse",
  "displayName": "Chandra Hybrid PDF Parse",
  "version": "0.2.0",
  "description": "Convert academic paper PDFs to Markdown/HTML with the Chandra OCR model and recover the vector-based figures Chandra skips, using deterministic PDF tools with the agent in the loop.",
  "author": {
    "name": "Yihui Ren",
    "url": "https://github.com/YHRen"
  },
  "repository": "https://github.com/YHRen/chandra_pdf2md_client",
  "license": "MIT",
  "keywords": [
    "pdf",
    "ocr",
    "markdown",
    "chandra",
    "figures"
  ],
  "mcpServers": {
    "chandra": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "run",
        "--quiet",
        "chandra-mcp"
      ]
    }
  }
}
